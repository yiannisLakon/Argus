<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Greek output is plain UTF-8 bytes and all formatting is invariant, so the smaller/faster
         invariant globalization is fine here (no culture-aware casing needed). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Release ships pdb-free: emit no debug symbols at all (no separate .pdb, none embedded), so
       publish output is clean without a post-publish strip. Debug keeps full symbols. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
