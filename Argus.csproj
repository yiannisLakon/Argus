<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <AssemblyName>argus</AssemblyName>
    <RootNamespace>Argus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Native AOT: a single self-contained native binary. The runtime is statically linked by
         necessity (the one sanctioned case of embedding the runtime — see workspace CLAUDE.md). -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ carries its own csproj; keep its sources out of the exe's default compile glob. -->
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="Argus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

</Project>
